---
import type { MarkdownHeading } from '@astrojs/markdown-remark';
import Sidebar from '../components/Sidebar.astro';
import { GITHUB_REPO, joinBase } from '../lib/repo';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentSlug?: string;
  toc?: MarkdownHeading[];
  section?: 'overview' | 'visualizations' | 'study-guide';
}

const {
  title,
  description = 'Data structures and algorithms explained, visualized step by step, and implemented in Python, C++ and Go.',
  currentSlug,
  toc = [],
  section,
} = Astro.props;

const base = import.meta.env.BASE_URL;
const href = (slug: string) => joinBase(base, slug);
const tocItems = toc.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = tocItems.length > 2;
const pageTitle = title === 'DSA Playground' ? title : `${title} \u00b7 DSA Playground`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${href('')}favicon.svg`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <script is:inline>
      (() => {
        try {
          // ?theme=light|dark previews a theme without remembering it.
          const forced = new URLSearchParams(location.search).get('theme');
          const t = forced ?? localStorage.getItem('dsa-theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
        } catch (e) {
          /* storage unavailable: follow the OS setting */
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <button class="icon-button menu-button" type="button" aria-label="Toggle navigation" aria-expanded="false" data-menu-toggle>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
      </button>
      <a class="brand" href={href('')}>
        <img src={`${href('')}favicon.svg`} alt="" width="26" height="26" />
        DSA Playground
      </a>
      <nav class="header-nav" aria-label="Primary">
        <a href={href('overview')} aria-current={section === 'overview' ? 'page' : undefined}>Overview</a>
        <a href={href('visualizations')} aria-current={section === 'visualizations' ? 'page' : undefined}>Visualizations</a>
        <a href={href('study-guide')} aria-current={section === 'study-guide' ? 'page' : undefined}>Study guide</a>
      </nav>
      <div class="header-actions">
        <button class="icon-button" type="button" aria-label="Toggle dark mode" data-theme-toggle>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M12 3a6 6 0 1 0 9 9 9 9 0 1 1-9-9Z"></path>
          </svg>
        </button>
        <a class="icon-button" href={GITHUB_REPO} target="_blank" rel="noopener noreferrer" aria-label="GitHub repository">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path>
          </svg>
        </a>
      </div>
    </header>

    <div class:list={['layout', { 'has-toc': showToc }]}>
      <Sidebar currentSlug={currentSlug} />
      <main id="main" class="content">
        <div class="content-inner">
          <slot />
        </div>
      </main>
      {
        showToc && (
          <aside class="toc" aria-label="On this page">
            <h2>On this page</h2>
            <ol>
              {tocItems.map((h) => (
                <li class={`depth-${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text.replace(/^[^\p{L}\p{N}]+/u, '')}</a>
                </li>
              ))}
            </ol>
          </aside>
        )
      }
    </div>

    <footer class="site-footer">
      Content comes straight from the <a href={GITHUB_REPO} target="_blank" rel="noopener noreferrer">dsa-playground</a> READMEs &#xb7;
      MIT License
    </footer>

    <script>
      const root = document.documentElement;
      const effectiveTheme = () =>
        root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = effectiveTheme() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('dsa-theme', next);
        } catch {
          /* storage unavailable: the choice lasts for this page only */
        }
      });

      const menu = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      menu?.addEventListener('click', () => {
        const open = document.body.classList.toggle('nav-open');
        menu.setAttribute('aria-expanded', String(open));
      });

      // Sidebar filter: show matching items plus the categories that contain them.
      const search = document.querySelector<HTMLInputElement>('[data-nav-search]');
      const items = Array.from(document.querySelectorAll<HTMLLIElement>('[data-nav-text]')).reverse();
      search?.addEventListener('input', () => {
        const q = search.value.trim().toLowerCase();
        for (const li of items) {
          const self = (li.dataset.navText ?? '').includes(q);
          const child = li.querySelector(':scope > details > ul > li:not([hidden])') !== null;
          li.hidden = q !== '' && !self && !child;
          const details = li.querySelector<HTMLDetailsElement>(':scope > details');
          if (details) details.open = q === '' ? details.dataset.initialOpen === 'true' : child;
        }
      });
    </script>
  </body>
</html>
