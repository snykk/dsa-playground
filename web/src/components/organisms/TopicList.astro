---
import { getCollection } from 'astro:content';
import { showVizMarkers } from '../../lib/coverage';
import { formatInline } from '../../lib/inline';
import { getContent, joinBase } from '../../lib/repo';
import { hasViz } from '../../viz/catalog';
import LevelMeter from '../atoms/LevelMeter.astro';

/**
 * A titled list of topics in reading order, for a study path. MDX:
 *   <TopicList title="Hashing" note="..." topics={['Data_Structures/Hashing/Hash_Table', ...]} />
 * Each row links to the topic and shows its area, its level and, while some topics have none,
 * whether it has a visualization.
 * Every entry must be a topic folder; the build fails otherwise.
 *
 * With JavaScript each row also gets a "done" checkbox and the header a count ("2 of 7 done");
 * the ticks live in this browser's storage (src/lib/progress.ts) and StudyProgress shows the
 * total. Without JavaScript the checkboxes stay hidden and the list is a plain list.
 */
interface Props {
  topics: string[];
  title?: string;
  /** One or two sentences under the title; inline code and arrows are typeset. */
  note?: string;
}

const { topics, title, note } = Astro.props;
const base = import.meta.env.BASE_URL;
const content = getContent();
const articles = new Map((await getCollection('articles')).map((a) => [a.data.topic, a.data]));
const DOT = String.fromCodePoint(0x25cf);
const markers = showVizMarkers();

const rows = topics.map((rel) => {
  const node = content.byRel.get(rel);
  if (!node || node.kind !== 'topic') throw new Error(`TopicList: "${rel}" is not a topic folder`);
  const article = articles.get(rel);
  const parent = node.parent && node.parent.kind !== 'root' ? node.parent : undefined;
  return {
    rel,
    href: joinBase(base, node.slug),
    title: article?.title ?? node.title,
    // The folder's own name ("Linked List", "Sorting"), shorter and more uniform than its page title.
    area: parent ? parent.name.replace(/_/g, ' ') : undefined,
    level: article?.level,
    visualized: hasViz(rel),
  };
});
const visualized = rows.filter((r) => r.visualized).length;
const count = `${rows.length === 1 ? '1 topic' : `${rows.length} topics`}${markers && visualized > 0 ? `, ${visualized} visualized` : ''}`;
---

<section class="topic-list" data-topic-list>
  {
    (title || note) && (
      <header>
        <div class="head">
          {title && <h3>{title}</h3>}
          <span class="count" data-progress-count>
            {count}
          </span>
        </div>
        {note && <p class="note" set:html={formatInline(note)} />}
      </header>
    )
  }
  <ol>
    {
      rows.map((r, i) => (
        <li data-topic={r.rel}>
          <label class="done" hidden>
            <input type="checkbox" value={r.rel} data-progress-box />
            <span class="visually-hidden">Mark {r.title} as done</span>
          </label>
          <a href={r.href}>
            <span class="num" aria-hidden="true">
              {i + 1}
            </span>
            <span class="main">
              <span class="title">{r.title}</span>
              {r.area && <span class="area">{r.area}</span>}
            </span>
            <span class="meta">
              {r.level && <LevelMeter level={r.level} />}
              {markers && r.visualized && (
                <span class="visualized">
                  <span class="dot" aria-hidden="true">
                    {DOT}
                  </span>
                  Visualized
                </span>
              )}
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</section>

<script>
  import { countDone, openProgress, PROGRESS_KEY, progressText } from '../../lib/progress';

  // One script for every list on the page (Astro bundles it once). Ticks are saved as they
  // change and follow other tabs through the storage event.
  const lists = Array.from(document.querySelectorAll<HTMLElement>('[data-topic-list]'));
  if (lists.length > 0) {
    const store = openProgress(() => window.localStorage);
    const summary = document.querySelector<HTMLElement>('[data-progress-summary]');
    const topicsOf = (root: ParentNode) => Array.from(root.querySelectorAll<HTMLElement>('[data-topic]'), (row) => row.dataset.topic ?? '');

    const render = () => {
      for (const list of lists) {
        for (const row of list.querySelectorAll<HTMLElement>('[data-topic]')) {
          const done = store.done.has(row.dataset.topic ?? '');
          row.classList.toggle('is-done', done);
          const box = row.querySelector<HTMLInputElement>('[data-progress-box]');
          if (box) box.checked = done;
        }
        const count = list.querySelector('[data-progress-count]');
        if (count) {
          const c = countDone(topicsOf(list), store.done);
          count.textContent = progressText(c.done, c.total);
        }
      }
      if (!summary) return;
      const c = countDone(lists.flatMap(topicsOf), store.done);
      const total = summary.querySelector('[data-progress-total]');
      if (total) total.textContent = progressText(c.done, c.total, 'topics');
      const bar = summary.querySelector<HTMLElement>('[data-progress-bar]');
      if (bar) bar.style.width = `${c.total ? (100 * c.done) / c.total : 0}%`;
      const clear = summary.querySelector<HTMLButtonElement>('[data-progress-clear]');
      if (clear) clear.hidden = c.done === 0;
      const note = summary.querySelector('[data-progress-note]');
      if (note && !store.saved) note.textContent = 'This browser is not keeping data for this site, so your ticks last until you leave the page.';
    };

    for (const list of lists) {
      for (const label of list.querySelectorAll<HTMLElement>('.done')) label.hidden = false;
      list.addEventListener('change', (e) => {
        const box = e.target;
        if (!(box instanceof HTMLInputElement) || !box.matches('[data-progress-box]')) return;
        store.set(box.value, box.checked);
        render();
      });
    }

    summary?.querySelector('[data-progress-clear]')?.addEventListener('click', () => {
      const n = store.done.size;
      if (n === 0 || !window.confirm(`Clear all ${n} ticks? This cannot be undone.`)) return;
      store.clear();
      render();
      // The button hides with nothing left to clear: move focus to the count and say what happened.
      summary.querySelector<HTMLElement>('[data-progress-total]')?.focus();
      const status = summary.querySelector('[data-progress-status]');
      if (status) status.textContent = 'All ticks cleared.';
    });

    window.addEventListener('storage', (e) => {
      if (e.key !== PROGRESS_KEY && e.key !== null) return;
      store.reload();
      render();
    });

    render();
    if (summary) summary.hidden = false;
  }
</script>

<style>
  .topic-list {
    margin: 20px 0 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }
  header {
    padding: 14px 16px 12px;
    border-bottom: 1px solid var(--border);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 12px;
  }
  h3 {
    margin: 0;
    font-size: 16.5px;
    font-weight: 650;
    line-height: 1.35;
  }
  .count {
    font-size: 13px;
    color: var(--text-3);
  }
  .note {
    margin: 6px 0 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--text-2);
  }
  .note :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
  }
  ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: flex;
    transition: background-color 0.15s ease;
  }
  li + li {
    border-top: 1px solid var(--border);
  }
  li:hover {
    background: var(--surface-2);
  }
  a {
    flex: 1;
    min-width: 0;
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr) auto;
    align-items: center;
    gap: 4px 12px;
    padding: 9px 16px;
    color: var(--text);
    text-decoration: none;
  }
  /* The done checkbox, shown by the script; the whole cell is its label. */
  .done {
    display: flex;
    align-items: center;
    padding: 0 2px 0 16px;
    cursor: pointer;
  }
  .done[hidden] {
    display: none;
  }
  .done input {
    width: 18px;
    height: 18px;
    margin: 0;
    accent-color: var(--accent);
    cursor: pointer;
  }
  .is-done .title {
    color: var(--text-2);
  }
  a:hover .title {
    color: var(--link);
  }
  .num {
    font-size: 12.5px;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
  .main {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 10px;
    min-width: 0;
  }
  .title {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
  }
  .area {
    font-size: 13px;
    color: var(--text-3);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 4px 14px;
    font-size: 13px;
    color: var(--text-3);
  }
  .visualized {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .dot {
    font-size: 9px;
    color: var(--viz-done);
  }
  @media (max-width: 560px) {
    a {
      grid-template-columns: 22px minmax(0, 1fr);
    }
    .meta {
      grid-column: 2;
      justify-content: flex-start;
    }
  }
  /* On paper the ticks stay (a printed checklist), and a list may run onto the next page. */
  @media print {
    .topic-list {
      overflow: visible;
    }
  }
</style>
