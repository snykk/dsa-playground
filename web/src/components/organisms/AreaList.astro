---
import { getCollection } from 'astro:content';
import { showVizMarkers } from '../../lib/coverage';
import { joinBase, topicsUnder, type DocNode } from '../../lib/repo';
import { hasViz } from '../../viz/catalog';

/**
 * The repository's top-level areas as a list: each area's name, the first sentence of its
 * overview, how many topics it has and, while some topics have none, how many are visualized.
 */
interface Props {
  heading: string;
  areas: DocNode[];
}

const { heading, areas } = Astro.props;
const base = import.meta.env.BASE_URL;
const overviews = new Map((await getCollection('categories')).map((c) => [c.data.category, c.data]));
const markers = showVizMarkers();
const firstSentence = (text: string) => {
  const m = text.match(/^.*?[.!?](?=\s|$)/);
  return m ? m[0] : text;
};
const rows = areas.map((n) => {
  const overview = overviews.get(n.rel);
  const topics = topicsUnder(n);
  const visualized = topics.filter((t) => hasViz(t.rel)).length;
  return {
    href: joinBase(base, n.slug),
    title: overview?.title ?? n.title,
    note: firstSentence(overview?.lead ?? n.description),
    count: `${topics.length} ${topics.length === 1 ? 'topic' : 'topics'}${markers && visualized > 0 ? `, ${visualized} visualized` : ''}`,
  };
});
---

<section class="areas" aria-labelledby="areas-title">
  <h2 id="areas-title">{heading}</h2>
  <ul>
    {
      rows.map((r) => (
        <li>
          <a href={r.href}>{r.title}</a>
          <span class="count">{r.count}</span>
          <p>{r.note}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .areas {
    margin-top: 64px;
  }
  h2 {
    font-size: 24px;
    font-weight: 700;
    line-height: 1.25;
    margin: 0 0 18px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 22px;
  }
  li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 2px 16px;
  }
  a {
    font-size: 18px;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
  }
  a:hover {
    color: var(--link);
  }
  .count {
    font-size: 14px;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }
  p {
    grid-column: 1 / -1;
    margin: 0;
    max-width: 68ch;
    color: var(--text-2);
  }
  @media (max-width: 640px) {
    li {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
