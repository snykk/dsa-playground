---
import { joinBase, topicsUnder, type DocNode } from '../../lib/repo';
import { hasViz } from '../../viz/catalog';

/**
 * The folders under a README-only page, as a list: each title links to its page, then its
 * one-line description and what it holds (languages for a topic, topics for a category).
 */
interface Props {
  nodes: DocNode[];
}

const { nodes } = Astro.props;
const base = import.meta.env.BASE_URL;
const holds = (n: DocNode) => {
  const parts =
    n.kind === 'topic'
      ? [n.languages.map((l) => l.label).join(', ')]
      : topicsUnder(n).length > 0
        ? [`${topicsUnder(n).length} topics`]
        : [];
  if (hasViz(n.rel)) parts.push('visualized');
  return parts.join(', ');
};
---

<ul class="children">
  {
    nodes.map((n) => (
      <li>
        <a href={joinBase(base, n.slug)}>{n.title}</a>
        {n.description && <p>{n.description}</p>}
        {holds(n) && <span>{holds(n)}</span>}
      </li>
    ))
  }
</ul>

<style>
  .children {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  li {
    display: grid;
    gap: 2px;
    max-width: 68ch;
  }
  a {
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
  }
  a:hover {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  p {
    margin: 0;
    color: var(--text-2);
  }
  span {
    font-size: 14px;
    color: var(--text-3);
  }
</style>
