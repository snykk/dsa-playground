---
import { joinBase } from '../../lib/repo';
import VizMount from '../../viz/VizMount';
import Button from '../atoms/Button.astro';

/**
 * Home page opener: a short pitch with the repository's own numbers, two calls to action,
 * and the product itself, a visualization running on the graph-paper stage.
 */
interface Props {
  topics: number;
  visualized: number;
}

const { topics, visualized } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <h1>Step through data structures and algorithms on your own input.</h1>
  <p class="pitch">
    {
      visualized === topics ? (
        <>
          {topics} topics, each with an article, tested code in Python, C++ and Go, and a visualization that runs step by
          step, with a caption that says why each step happens.
        </>
      ) : (
        <>
          {topics} topics, each with an article and tested code in Python, C++ and Go. {visualized} of them run step by
          step, with a caption that says why each step happens.
        </>
      )
    }
  </p>
  <div class="hero-actions">
    <Button href={joinBase(base, 'visualizations')} variant="primary">Browse visualizations</Button>
    <Button href={joinBase(base, 'study-guide')}>Follow the study guide</Button>
  </div>
  <div class="hero-demo" role="group" aria-label="Live demo: quick sort on random input">
    <VizMount client:visible ids={['quick-sort']} autoplay loop compact />
  </div>
</section>

<style>
  .hero {
    padding: 40px 0 8px;
    /* The demo's glow (below) paints under everything in the hero, text and buttons included. */
    isolation: isolate;
  }
  h1 {
    font-size: clamp(32px, 5.2vw, 48px);
    line-height: 1.08;
    font-weight: 800;
    letter-spacing: -0.025em;
    max-width: 23ch;
    margin: 0 0 18px;
    text-wrap: balance;
  }
  .pitch {
    font-size: 19px;
    line-height: 1.55;
    color: var(--text-2);
    max-width: 56ch;
    margin: 0 0 26px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .hero-demo {
    margin-top: 32px;
    position: relative;
  }
  /* A soft glow of the accent rising from behind the demo: the light peaks at the demo's top
     edge and fades over the buttons and the pitch above it (the demo's own card hides the rest).
     It spans the demo's width and no more, so a phone never scrolls sideways; on paper it is
     barely there, in the dark theme it shows. The colours are --hero-glow* in tokens.css. */
  .hero-demo::before {
    content: '';
    position: absolute;
    inset: -220px 0 auto;
    height: 440px;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(60% 50% at 50% 50%, var(--hero-glow), transparent 70%),
      radial-gradient(30% 35% at 18% 50%, var(--hero-glow-2), transparent 70%);
  }
  @media print {
    .hero-demo::before {
      display: none;
    }
  }
</style>
