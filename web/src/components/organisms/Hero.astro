---
import { joinBase } from '../../lib/repo';
import VizMount from '../../viz/VizMount';
import Button from '../atoms/Button.astro';

/** Home page opener: the pitch, calls to action and a live, looping visualization. */
const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <h1>Learn data structures &amp; algorithms by watching them run.</h1>
  <p>
    Every topic pairs a written explanation with a step-by-step visualization you can drive yourself, and with tested
    implementations in Python, C++ and Go.
  </p>
  <div class="hero-actions">
    <Button href={joinBase(base, 'visualizations')} variant="primary">Browse visualizations</Button>
    <Button href={joinBase(base, 'study-guide')}>Follow the study guide</Button>
    <Button href={joinBase(base, 'overview')}>Repository overview</Button>
  </div>
  <div class="hero-demo" aria-label="Live demo: quick sort on random input">
    <VizMount client:visible ids={['quick-sort']} autoplay loop compact />
  </div>
</section>

<style>
  .hero {
    padding: 32px 0 8px;
  }
  h1 {
    font-size: clamp(32px, 5vw, 48px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
  }
  p {
    font-size: 18px;
    color: var(--text-2);
    max-width: 680px;
    margin: 0 0 24px;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .hero-demo {
    margin-top: 28px;
  }
</style>
