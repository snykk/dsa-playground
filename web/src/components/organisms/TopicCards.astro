---
import { joinBase, topicsUnder, type DocNode } from '../../lib/repo';
import { hasViz } from '../../viz/catalog';
import Card from '../molecules/Card.astro';
import CardGrid from '../molecules/CardGrid.astro';

/** Cards for repository folders: languages for topics, topic counts for categories. */
interface Props {
  nodes: DocNode[];
}

const { nodes } = Astro.props;
const base = import.meta.env.BASE_URL;
const MIDDOT = String.fromCodePoint(0xb7);
const DOT = String.fromCodePoint(0x25cf);
const meta = (n: DocNode) => [
  n.kind === 'topic' ? n.languages.map((l) => l.label).join(` ${MIDDOT} `) : `${topicsUnder(n).length} topics`,
  ...(hasViz(n.rel) ? [`${DOT} visualized`] : []),
];
---

<CardGrid>
  {nodes.map((n) => <Card href={joinBase(base, n.slug)} title={n.title} text={n.description} meta={meta(n)} />)}
</CardGrid>
