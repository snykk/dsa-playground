---
import { GITHUB_REPO } from '../../lib/repo';

/** Copyright (matching LICENSE, which starts in 2025) and where the site comes from. */
const FIRST_YEAR = 2025;
const buildYear = new Date().getFullYear();
const years = buildYear > FIRST_YEAR ? `${FIRST_YEAR}${String.fromCodePoint(0x2013)}${buildYear}` : `${FIRST_YEAR}`;
---

<footer class="site-footer">
  <p class="copyright">&copy; {years} Najib Fikri &#xb7; MIT License</p>
  <p>
    Built from the <a href={GITHUB_REPO} target="_blank" rel="noopener noreferrer">dsa-playground</a> repository: its code, its tests and its documents
  </p>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 20px 16px;
    color: var(--text-3);
    font-size: 14px;
    text-align: center;
  }
  p {
    margin: 0;
  }
  .copyright {
    color: var(--text-2);
    margin-bottom: 4px;
  }
</style>
