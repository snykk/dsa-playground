---
import { getContent, joinBase, slugOfRel } from '../../lib/repo';
import { VIZ_CATALOG, VIZ_GROUP_ORDER } from '../../viz/catalog';

/**
 * Every visualization, grouped by area like a book's index: the area, how many it has,
 * then its visualizations as links to the page that shows each one.
 */
interface Props {
  heading: string;
}

const { heading } = Astro.props;
const base = import.meta.env.BASE_URL;
const content = getContent();
const groups = VIZ_GROUP_ORDER.map((group) => ({
  group,
  items: VIZ_CATALOG.filter((v) => v.group === group).map((v) => ({
    title: v.title,
    blurb: v.blurb,
    href: `${joinBase(base, slugOfRel(content, v.topics[0]))}#visualize`,
  })),
})).filter((g) => g.items.length > 0);
---

<section class="viz-index" aria-labelledby="viz-index-title">
  <h2 id="viz-index-title">{heading}</h2>
  <dl>
    {
      groups.map((g) => (
        <div class="row">
          <dt>
            <span class="group">{g.group}</span>
            <span class="count">{g.items.length}</span>
          </dt>
          <dd>
            <ul>
              {g.items.map((v) => (
                <li>
                  <a href={v.href} title={v.blurb}>
                    {v.title}
                  </a>
                </li>
              ))}
            </ul>
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .viz-index {
    margin-top: 64px;
  }
  h2 {
    font-size: 24px;
    font-weight: 700;
    line-height: 1.25;
    margin: 0 0 18px;
  }
  dl {
    margin: 0;
  }
  .row {
    display: grid;
    grid-template-columns: 190px minmax(0, 1fr);
    gap: 4px 24px;
    padding: 12px 0;
  }
  .row + .row {
    border-top: 1px solid var(--border);
  }
  dt {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    font-weight: 700;
  }
  .count {
    font-weight: 400;
    font-size: 14px;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }
  dd {
    margin: 0;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
  }
  a {
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--axis);
  }
  a:hover {
    color: var(--link);
    border-bottom-color: currentColor;
  }
  @media (max-width: 640px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
    dt {
      justify-content: flex-start;
    }
  }
</style>
