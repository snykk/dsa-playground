---
import { GITHUB_REPO, joinBase } from '../../lib/repo';
import Icon from '../atoms/Icon.astro';
import IconButton from '../atoms/IconButton.astro';
import ThemeToggle from '../molecules/ThemeToggle.astro';

/** Sticky top bar: menu button (small screens), brand, primary navigation, search, theme and GitHub. */
interface Props {
  section?: 'overview' | 'visualizations' | 'study-guide';
}

const { section } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  { id: 'overview', label: 'Overview' },
  { id: 'visualizations', label: 'Visualizations' },
  { id: 'study-guide', label: 'Study guide' },
] as const;
---

<header class="site-header">
  <span class="menu-slot">
    <IconButton label="Toggle navigation" aria-expanded="false" data-menu-toggle>
      <Icon name="menu" />
    </IconButton>
  </span>
  <a class="brand" href={joinBase(base, '')}>
    <img src={`${joinBase(base, '')}favicon.svg`} alt="" width="26" height="26" />
    <span class="brand-name">DSA Playground</span>
  </a>
  <nav class="header-nav" aria-label="Primary">
    {
      links.map((l) => (
        <a href={joinBase(base, l.id)} aria-current={section === l.id ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>
  <div class="header-actions">
    <button type="button" class="search-button" aria-label="Search the articles" aria-haspopup="dialog" aria-keyshortcuts="/" data-search-open>
      <Icon name="search" size={17} />
      <span class="search-label" aria-hidden="true">Search</span>
      <kbd class="search-key" aria-hidden="true">/</kbd>
    </button>
    <ThemeToggle />
    <IconButton label="GitHub repository" href={GITHUB_REPO}>
      <Icon name="github" />
    </IconButton>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  menu?.addEventListener('click', () => {
    const open = document.body.classList.toggle('nav-open');
    menu.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 0 16px;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  .brand img {
    width: 26px;
    height: 26px;
  }
  .header-nav {
    display: flex;
    gap: 4px;
    margin-left: 8px;
  }
  .header-nav a {
    color: var(--text-2);
    text-decoration: none;
    padding: 6px 10px;
    border-radius: 8px;
    font-size: 15px;
  }
  .header-nav a:hover,
  .header-nav a[aria-current='page'] {
    color: var(--text);
    background: var(--surface-2);
  }
  .header-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .menu-slot {
    display: none;
  }
  /* Looks like a quiet field on wide screens (SearchDialog opens on a click or "/"), and like
     the other icon buttons on narrow ones. */
  .search-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: 208px;
    height: 36px;
    margin-right: 4px;
    padding: 0 6px 0 10px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text-3);
    font: inherit;
    font-size: 14px;
    cursor: pointer;
  }
  .search-button:hover {
    color: var(--text-2);
    border-color: var(--border-strong);
  }
  .search-label {
    flex: 1;
    text-align: left;
  }
  .search-key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 22px;
    border: 1px solid var(--border);
    border-bottom-width: 2px;
    border-radius: 5px;
    background: var(--surface-2);
    color: var(--text-2);
    font: 500 12px/1 var(--font-mono);
  }
  @media (max-width: 959px) {
    .menu-slot {
      display: inline-flex;
    }
    .header-nav {
      display: none;
    }
    .search-button {
      width: auto;
      min-width: 36px;
      margin-right: 0;
      padding: 0 8px;
      justify-content: center;
      color: var(--text-2);
    }
    .search-label,
    .search-key {
      display: none;
    }
  }
  /* In a window narrower than 360px (a small phone, or zoomed in) the bar holds the logo
     alone, so it fits without scrolling sideways; the name stays for screen readers. */
  @media (max-width: 359px) {
    .brand-name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
  }
</style>
