---
import { GITHUB_REPO, joinBase } from '../../lib/repo';
import Icon from '../atoms/Icon.astro';
import IconButton from '../atoms/IconButton.astro';
import ThemeToggle from '../molecules/ThemeToggle.astro';

/** Sticky top bar: menu button (small screens), brand, primary navigation, theme and GitHub. */
interface Props {
  section?: 'overview' | 'visualizations' | 'study-guide';
}

const { section } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  { id: 'overview', label: 'Overview' },
  { id: 'visualizations', label: 'Visualizations' },
  { id: 'study-guide', label: 'Study guide' },
] as const;
---

<header class="site-header">
  <span class="menu-slot">
    <IconButton label="Toggle navigation" aria-expanded="false" data-menu-toggle>
      <Icon name="menu" />
    </IconButton>
  </span>
  <a class="brand" href={joinBase(base, '')}>
    <img src={`${joinBase(base, '')}favicon.svg`} alt="" width="26" height="26" />
    DSA Playground
  </a>
  <nav class="header-nav" aria-label="Primary">
    {
      links.map((l) => (
        <a href={joinBase(base, l.id)} aria-current={section === l.id ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>
  <div class="header-actions">
    <ThemeToggle />
    <IconButton label="GitHub repository" href={GITHUB_REPO}>
      <Icon name="github" />
    </IconButton>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  menu?.addEventListener('click', () => {
    const open = document.body.classList.toggle('nav-open');
    menu.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 0 16px;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  .brand img {
    width: 26px;
    height: 26px;
  }
  .header-nav {
    display: flex;
    gap: 4px;
    margin-left: 8px;
  }
  .header-nav a {
    color: var(--text-2);
    text-decoration: none;
    padding: 6px 10px;
    border-radius: 8px;
    font-size: 15px;
  }
  .header-nav a:hover,
  .header-nav a[aria-current='page'] {
    color: var(--text);
    background: var(--surface-2);
  }
  .header-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .menu-slot {
    display: none;
  }
  @media (max-width: 959px) {
    .menu-slot {
      display: inline-flex;
    }
    .header-nav {
      display: none;
    }
  }
</style>
