---
import type { Fact, Property } from '../../lib/article';
import Icon from '../atoms/Icon.astro';
import FactTile from '../molecules/FactTile.astro';

/** The at-a-glance panel under an article title: fact tiles plus yes/no properties. */
interface Props {
  facts: Fact[];
  properties?: Property[];
}

const { facts, properties = [] } = Astro.props;
---

<section class="key-facts" aria-label="Key facts">
  <div class="facts">
    {facts.map((f) => <FactTile {...f} />)}
  </div>
  {
    properties.length > 0 && (
      <ul class="properties">
        {properties.map((p) => (
          <li class:list={['property', p.value ? 'yes' : 'no']}>
            <Icon name={p.value ? 'check' : 'cross'} size={15} />
            {p.label}
            <span class="visually-hidden">: {p.value ? 'yes' : 'no'}</span>
          </li>
        ))}
      </ul>
    )
  }
</section>

<style>
  .key-facts {
    margin: 0 0 8px;
  }
  /* One sheet for all the facts: they are read together, not as separate cards. */
  .facts {
    padding: 18px 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    row-gap: 18px;
    column-gap: 28px;
    display: grid;
    /* At most as wide as the article, so a phone gets one column and a long complexity such as
       O(1 / (1 - load)), which never wraps, still fits its tile. */
    grid-template-columns: repeat(auto-fit, minmax(min(180px, 100%), 1fr));
  }
  .properties {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 12px 0 0;
    padding: 0;
  }
  .property {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px 4px 9px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 14px;
  }
  .property.yes :global(svg) {
    color: var(--viz-good);
  }
  .property.no {
    color: var(--text-2);
  }
  .property.no :global(svg) {
    color: var(--viz-bad);
  }
</style>
