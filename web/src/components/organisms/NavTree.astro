---
/**
 * Recursive folder tree; styled by Sidebar. Categories on the current path start open.
 * A category row is a disclosure toggle (a <details> holding only its <summary>, the chevron)
 * beside the link to the category page; CSS shows the nested list while the toggle is open.
 * The link sits outside the summary because a summary's content is not exposed as a link.
 */
import { joinBase, type DocNode } from '../../lib/repo';

interface Props {
  nodes: DocNode[];
  currentSlug?: string;
  root?: boolean;
}

const { nodes, currentSlug, root = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const isOnPath = (n: DocNode) =>
  currentSlug !== undefined && (currentSlug === n.slug || currentSlug.startsWith(`${n.slug}/`));
---

<ul class={root ? 'tree' : undefined}>
  {
    nodes.map((n) => {
      const current = currentSlug === n.slug ? 'page' : undefined;
      return (
        <li class={n.children.length > 0 ? 'branch' : undefined} data-nav-text={n.title.toLowerCase()}>
          {n.children.length > 0 ? (
            <>
              <details open={isOnPath(n)} data-initial-open={String(isOnPath(n))}>
                <summary>
                  <span class="visually-hidden">{n.title} topics</span>
                </summary>
              </details>
              <a href={joinBase(base, n.slug)} aria-current={current}>
                {n.title}
              </a>
              <Astro.self nodes={n.children} currentSlug={currentSlug} />
            </>
          ) : (
            <a class="leaf" href={joinBase(base, n.slug)} aria-current={current}>
              {n.title}
            </a>
          )}
        </li>
      );
    })
  }
</ul>
