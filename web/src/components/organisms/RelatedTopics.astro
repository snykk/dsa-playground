---
import { getContent, joinBase } from '../../lib/repo';

/** "Where to go next" at the end of an article: a short list of links, each with its area. */
interface Props {
  title: string;
  topics: string[];
}

const { title, topics } = Astro.props;
const base = import.meta.env.BASE_URL;
const content = getContent();
const nodes = topics.map((rel) => {
  const n = content.byRel.get(rel);
  if (!n) throw new Error(`RelatedTopics: unknown topic folder "${rel}"`);
  return n;
});
const id = `related-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

{
  nodes.length > 0 && (
    <section class="related" aria-labelledby={id} data-pagefind-ignore>
      <h2 id={id}>{title}</h2>
      <ul>
        {nodes.map((n) => (
          <li>
            <a href={joinBase(base, n.slug)}>{n.title}</a>
            {n.parent && n.parent.kind !== 'root' && <span>{n.parent.title}</span>}
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .related {
    margin-top: 56px;
  }
  h2 {
    font-size: 24px;
    font-weight: 700;
    line-height: 1.25;
    margin: 0 0 14px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px 28px;
  }
  li {
    display: grid;
    gap: 1px;
  }
  a {
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
  }
  a:hover {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  span {
    font-size: 14px;
    color: var(--text-3);
  }
</style>
