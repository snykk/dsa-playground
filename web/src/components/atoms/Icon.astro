---
/** Decorative inline SVG icon (always aria-hidden; the parent carries the label). */
type StrokeIcon =
  | 'menu'
  | 'check'
  | 'cross'
  | 'info'
  | 'tip'
  | 'warning'
  | 'arrow-right'
  | 'play'
  | 'code'
  | 'chevron-down'
  | 'clock'
  | 'search';

interface Props {
  name: StrokeIcon | 'github';
  /** Width and height in px. */
  size?: number;
}

const { name, size = 18 } = Astro.props;

/** Outline icons on a 24px grid, drawn with the current text color. */
const STROKES: Record<StrokeIcon, string[]> = {
  menu: ['M4 7h16M4 12h16M4 17h16'],
  check: ['M20 6 9 17l-5-5'],
  cross: ['M18 6 6 18M6 6l12 12'],
  info: ['M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z', 'M12 16v-5M12 8h.01'],
  tip: ['M9 18h6M10 22h4', 'M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.3 1 2.1V18h6v-1.2c0-.8.4-1.6 1-2.1A7 7 0 0 0 12 2Z'],
  warning: ['M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z', 'M12 9v4M12 17h.01'],
  'arrow-right': ['M5 12h14M13 6l6 6-6 6'],
  play: ['M7 4.5v15l12.5-7.5Z'],
  code: ['m16 18 6-6-6-6M8 6l-6 6 6 6'],
  'chevron-down': ['m6 9 6 6 6-6'],
  clock: ['M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z', 'M12 7v5l3 2'],
  search: ['M17 11a6 6 0 1 1-12 0 6 6 0 0 1 12 0Z', 'm15.5 15.5 4.5 4.5'],
};
const style = `width: ${size}px; height: ${size}px`;
---

{
  name === 'github' ? (
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style={style}>
      <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.8 1.19 1.83 1.19 3.09 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
    </svg>
  ) : (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      style={style}
    >
      {STROKES[name].map((d) => (
        <path d={d} />
      ))}
    </svg>
  )
}

<style>
  svg {
    display: block;
    flex: none;
  }
</style>
