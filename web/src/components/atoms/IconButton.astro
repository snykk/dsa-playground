---
import type { HTMLAttributes } from 'astro/types';

/**
 * Square button (or external link, opening in a new tab) holding an Icon; `label` is announced
 * to screen readers, with "(opens in a new tab)" for a link.
 */
type Props = HTMLAttributes<'button'> & {
  label: string;
  href?: string;
};

const { label, href, class: className, ...rest } = Astro.props;
---

{
  href ? (
    <a class:list={['icon-button', className]} href={href} target="_blank" rel="noopener noreferrer" aria-label={`${label} (opens in a new tab)`}>
      <slot />
    </a>
  ) : (
    <button type="button" class:list={['icon-button', className]} aria-label={label} {...rest}>
      <slot />
    </button>
  )
}

<style>
  .icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 36px;
    height: 36px;
    padding: 0 8px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text-2);
    cursor: pointer;
    text-decoration: none;
    font: inherit;
    font-size: 14px;
  }
  .icon-button:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }
</style>
