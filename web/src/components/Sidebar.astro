---
import { getContent, joinBase } from '../lib/repo';
import NavTree from './NavTree.astro';

interface Props {
  currentSlug?: string;
}

const { currentSlug } = Astro.props;
const { root } = getContent();
const base = import.meta.env.BASE_URL;
---

<nav class="sidebar" aria-label="Topics">
  <label class="visually-hidden" for="nav-search">Filter topics</label>
  <input id="nav-search" class="nav-search" type="search" placeholder="Filter topics&#x2026;" autocomplete="off" data-nav-search />
  <ul class="nav-links tree">
    <li><a href={joinBase(base, '')} aria-current={currentSlug === '' ? 'page' : undefined}>Home</a></li>
    <li><a href={joinBase(base, 'visualizations')} aria-current={currentSlug === 'visualizations' ? 'page' : undefined}>All visualizations</a></li>
    <li><a href={joinBase(base, 'study-guide')} aria-current={currentSlug === 'study-guide' ? 'page' : undefined}>Study guide</a></li>
  </ul>
  <NavTree nodes={root.children} currentSlug={currentSlug} root />
</nav>
