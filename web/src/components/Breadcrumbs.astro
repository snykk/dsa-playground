---
import { ancestors, joinBase, type DocNode } from '../lib/repo';

interface Props {
  node: DocNode;
}

const { node } = Astro.props;
const base = import.meta.env.BASE_URL;
const trail = ancestors(node);
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href={joinBase(base, '')}>Home</a></li>
    {trail.map((n) => <li><a href={joinBase(base, n.slug)}>{n.title}</a></li>)}
    <li aria-current="page">{node.title}</li>
  </ol>
</nav>
