---
/** Responsive grid for Card molecules. */
interface Props {
  min?: number;
}

const { min = 240 } = Astro.props;
---

<div class="card-grid" style={`--card-min: ${min}px`}><slot /></div>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(var(--card-min), 1fr));
    gap: 12px;
  }
</style>
