---
/** One headline number with its label. */
interface Props {
  value: string | number;
  label: string;
}

const { value, label } = Astro.props;
---

<div class="stat"><strong>{value}</strong><span>{label}</span></div>

<style>
  .stat {
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  strong {
    display: block;
    font-size: 28px;
    line-height: 1.1;
  }
  span {
    color: var(--text-2);
    font-size: 14px;
  }
</style>
