---
/** A list of frequently asked questions; each child is a <FaqItem>. */
---

<div class="faq"><slot /></div>

<style>
  /* The questions sit on one sheet, divided by rules, not on a card each. */
  .faq {
    margin: 20px 0 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }
  /* A clipping box cannot be split across pages, and the questions may fill more than one. */
  @media print {
    .faq {
      overflow: visible;
    }
  }
</style>
