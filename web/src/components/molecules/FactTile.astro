---
import { formatInline, isComplexity } from '../../lib/inline';
import Icon from '../atoms/Icon.astro';

/** One key fact of a topic: a label, a value (complexities in monospace) and an optional hint. */
interface Props {
  label: string;
  value: string;
  hint?: string;
  tone?: 'neutral' | 'warn';
}

const { label, value, hint, tone = 'neutral' } = Astro.props;
---

<div class:list={['fact', tone]}>
  <span class="fact-label">
    {tone === 'warn' && <Icon name="warning" size={14} />}
    {label}
  </span>
  <span class:list={['fact-value', { mono: isComplexity(value) }]} set:html={formatInline(value)} />
  {hint && <span class="fact-hint" set:html={formatInline(hint)} />}
</div>

<style>
  .fact {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid var(--border);
    background: var(--surface);
    min-width: 0;
  }
  .fact-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--text-3);
  }
  .fact.warn .fact-label :global(svg) {
    color: var(--viz-active);
  }
  .fact-value {
    font-size: 19px;
    font-weight: 650;
    line-height: 1.3;
  }
  .fact-value.mono {
    font-family: var(--font-mono);
    font-size: 18px;
  }
  .fact-hint {
    font-size: 13px;
    color: var(--text-2);
    line-height: 1.45;
  }
</style>
