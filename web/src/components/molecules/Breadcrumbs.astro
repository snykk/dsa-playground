---
import { ancestors, joinBase, type DocNode } from '../../lib/repo';

interface Props {
  node: DocNode;
}

const { node } = Astro.props;
const base = import.meta.env.BASE_URL;
const trail = ancestors(node);
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li><a href={joinBase(base, '')}>Home</a></li>
    {trail.map((n) => <li><a href={joinBase(base, n.slug)}>{n.title}</a></li>)}
    <li aria-current="page">{node.title}</li>
  </ol>
</nav>

<style>
  .breadcrumbs {
    font-size: 14px;
    color: var(--text-3);
    margin-bottom: 12px;
  }
  ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin: 0;
    padding: 0;
  }
  li:not(:last-child)::after {
    content: '/';
    margin-left: 4px;
    color: var(--axis);
  }
  a {
    color: var(--text-2);
    text-decoration: none;
  }
  a:hover {
    color: var(--link);
  }
</style>
