---
import { formatInline } from '../../lib/inline';
import Icon from '../atoms/Icon.astro';

/** Advantages next to disadvantages, each item marked with a check or a cross icon. */
interface Props {
  pros: string[];
  cons: string[];
  prosTitle?: string;
  consTitle?: string;
}

const { pros, cons, prosTitle = 'Advantages', consTitle = 'Disadvantages' } = Astro.props;
const sides = [
  { key: 'pros', title: prosTitle, items: pros, icon: 'check' as const },
  { key: 'cons', title: consTitle, items: cons, icon: 'cross' as const },
];
---

<div class="pros-cons">
  {
    sides.map((side) => (
      <section class:list={['side', side.key]} aria-label={side.title}>
        <p class="side-title">{side.title}</p>
        <ul>
          {side.items.map((item) => (
            <li>
              <span class="mark">
                <Icon name={side.icon} size={16} />
              </span>
              <span set:html={formatInline(item)} />
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  /* One sheet split down the middle; the check and cross marks carry the colour. */
  .pros-cons {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 20px 0 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .side {
    --tone: var(--viz-good);
    padding: 14px 18px 16px;
  }
  .side + .side {
    border-left: 1px solid var(--border);
  }
  .side.cons {
    --tone: var(--viz-bad);
  }
  .side-title {
    margin: 0 0 10px;
    font-weight: 700;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 10px;
    font-size: 15px;
    line-height: 1.55;
  }
  .mark {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-top: 1px;
    border-radius: 50%;
    color: var(--tone);
    background: color-mix(in srgb, var(--tone) 14%, transparent);
  }
  li :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
  }
  @media (max-width: 599px) {
    .pros-cons {
      grid-template-columns: minmax(0, 1fr);
    }
    .side + .side {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }
</style>
