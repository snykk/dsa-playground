---
/** A titled card with optional text and meta facts; a link when `href` is given. */
interface Props {
  title: string;
  text?: string;
  meta?: string[];
  href?: string;
}

const { title, text, meta = [], href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class:list={['card', { link: href }]} href={href}>
  <h3>{title}</h3>
  {text && <p>{text}</p>}
  {meta.length > 0 && <div class="card-meta">{meta.map((m) => <span>{m}</span>)}</div>}
</Tag>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }
  .card.link {
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }
  .card.link:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
  }
  h3 {
    margin: 0;
    font-size: 16px;
    line-height: 1.35;
  }
  p {
    margin: 0;
    font-size: 14px;
    color: var(--text-2);
    line-height: 1.5;
  }
  .card-meta {
    margin-top: auto;
    padding-top: 6px;
    font-size: 12px;
    color: var(--text-3);
    display: flex;
    gap: 10px;
  }
</style>
