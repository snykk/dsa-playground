---
import { formatInline } from '../../lib/inline';

/** One step of a <Steps> list: a short title plus an explanation (markdown in MDX). */
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<li class="step">
  <p class="step-title" set:html={formatInline(title)} />
  <div class="step-body"><slot /></div>
</li>

<style>
  /* A sequence reads as a numbered path, the same device as a category's reading order:
     circles joined by a line, no boxes. */
  .step {
    counter-increment: step;
    position: relative;
    padding-left: 46px;
  }
  .step::before {
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: 1.5px solid var(--accent);
    background: var(--surface);
    color: var(--accent-text);
    font-weight: 700;
    font-size: 14px;
  }
  .step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 13px;
    top: 34px;
    bottom: -14px;
    width: 2px;
    border-radius: 1px;
    background: var(--border-strong);
  }
  .step-title {
    margin: 2px 0 4px;
    font-weight: 700;
  }
  .step-body {
    color: var(--text-2);
    font-size: 15.5px;
    line-height: 1.65;
  }
  .step-body :global(p) {
    margin: 0 0 8px;
  }
  .step-body > :global(:last-child) {
    margin-bottom: 0;
  }
</style>
