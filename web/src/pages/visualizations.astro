---
import SectionTitle from '../components/atoms/SectionTitle.astro';
import Card from '../components/molecules/Card.astro';
import CardGrid from '../components/molecules/CardGrid.astro';
import BaseLayout from '../components/templates/BaseLayout.astro';
import { getContent, joinBase, slugOfRel } from '../lib/repo';
import { VIZ_CATALOG, VIZ_GROUP_ORDER } from '../viz/catalog';

const content = getContent();
const base = import.meta.env.BASE_URL;
const groups = VIZ_GROUP_ORDER.map((group) => ({ group, items: VIZ_CATALOG.filter((v) => v.group === group) })).filter((g) => g.items.length > 0);
---

<BaseLayout
  title="Visualizations"
  description="Interactive, step-by-step visualizations of sorting, searching, graph, tree, string, dynamic programming and coding theory algorithms."
  currentSlug="visualizations"
  section="visualizations"
>
  <article class="prose">
    <h1>Visualizations</h1>
    <p>
      Each visualization runs on input you choose. Use <kbd>Space</kbd> to play or pause and the arrow keys to step; every
      step explains what the algorithm just did and why. They live on the topic pages, next to the explanation and the code.
    </p>
  </article>
  {
    groups.map(({ group, items }) => (
      <section>
        <SectionTitle>{group}</SectionTitle>
        <CardGrid>
          {items.map((v) => (
            <Card
              href={`${joinBase(base, slugOfRel(content, v.topics[0]))}#visualize`}
              title={v.title}
              text={v.blurb}
              meta={[content.byRel.get(v.topics[0])?.title ?? '']}
            />
          ))}
        </CardGrid>
      </section>
    ))
  }
</BaseLayout>
