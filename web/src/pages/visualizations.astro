---
import BaseLayout from '../components/templates/BaseLayout.astro';
import { getContent, joinBase, slugOfRel } from '../lib/repo';
import { VIZ_CATALOG, VIZ_GROUP_ORDER } from '../viz/catalog';

const content = getContent();
const base = import.meta.env.BASE_URL;
const groups = VIZ_GROUP_ORDER.map((group) => ({
  group,
  items: VIZ_CATALOG.filter((v) => v.group === group).map((v) => ({
    title: v.title,
    blurb: v.blurb,
    href: `${joinBase(base, slugOfRel(content, v.topics[0]))}#visualize`,
  })),
})).filter((g) => g.items.length > 0);
const slug = (g: string) => g.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<BaseLayout
  title="Visualizations"
  description="Interactive, step-by-step visualizations of sorting, searching, graph, tree, string, dynamic programming and coding theory algorithms."
  currentSlug="visualizations"
  section="visualizations"
  toc={groups.map((g) => ({ depth: 2, slug: slug(g.group), text: g.group }))}
>
  <header class="intro">
    <h1>Visualizations</h1>
    <p>
      {VIZ_CATALOG.length} visualizations, by area. Each runs on input you choose: press <kbd>Space</kbd> to play or pause
      and the arrow keys to step, and every step says what the algorithm just did and why. Each one lives on its topic's
      page, next to the explanation and the code.
    </p>
  </header>
  {
    groups.map(({ group, items }) => (
      <section aria-labelledby={slug(group)}>
        <h2 id={slug(group)}>
          {group} <span class="count">{items.length}</span>
        </h2>
        <dl>
          {items.map((v) => (
            <div class="row">
              <dt>
                <a href={v.href}>{v.title}</a>
              </dt>
              <dd>{v.blurb}</dd>
            </div>
          ))}
        </dl>
      </section>
    ))
  }
</BaseLayout>

<style>
  .intro {
    padding: 8px 0 8px;
  }
  h1 {
    font-size: clamp(30px, 4.4vw, 40px);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
  }
  .intro p {
    max-width: var(--text-measure);
    font-size: 17px;
    color: var(--text-2);
    margin: 0;
  }
  kbd {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 1px 5px;
    border: 1px solid var(--border-strong);
    border-radius: 5px;
    background: var(--surface);
  }
  section {
    margin-top: 44px;
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  h2 {
    font-size: 22px;
    font-weight: 700;
    line-height: 1.3;
    margin: 0 0 8px;
  }
  .count {
    font-size: 15px;
    font-weight: 400;
    color: var(--text-3);
    font-variant-numeric: tabular-nums;
  }
  dl {
    margin: 0;
  }
  /* An index: the visualization's name, then what to watch for in it. */
  .row {
    display: grid;
    grid-template-columns: minmax(0, 260px) minmax(0, 1fr);
    gap: 2px 28px;
    padding: 10px 0;
  }
  .row + .row {
    border-top: 1px solid var(--border);
  }
  dt {
    font-weight: 700;
  }
  dt a {
    color: var(--text);
    text-decoration: none;
  }
  dt a:hover {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  dd {
    margin: 0;
    max-width: var(--text-measure);
    color: var(--text-2);
  }
  @media (max-width: 720px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
