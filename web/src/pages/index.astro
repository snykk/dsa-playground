---
import AreaList from '../components/organisms/AreaList.astro';
import Hero from '../components/organisms/Hero.astro';
import VizIndex from '../components/organisms/VizIndex.astro';
import BaseLayout from '../components/templates/BaseLayout.astro';
import { getContent } from '../lib/repo';
import { VIZ_CATALOG } from '../viz/catalog';

const content = getContent();
const topics = content.nodes.filter((n) => n.kind === 'topic');
const visualized = topics.filter((t) => VIZ_CATALOG.some((v) => v.topics.includes(t.rel))).length;
const steps = [
  { title: 'Read the article', text: 'The idea, a worked example, and why the complexity is what it is.' },
  { title: 'Step through it', text: 'Run the visualization on your own input. Pause, go back, and read why each step happens.' },
  { title: 'Compare the code', text: 'The same algorithm in Python, C++ and Go, each with its tests.' },
];
---

<BaseLayout title="DSA Playground" currentSlug="">
  <Hero topics={topics.length} visualized={visualized} />

  <section class="study" aria-labelledby="study-title">
    <h2 id="study-title">How to study a topic</h2>
    <ol>
      {
        steps.map((s) => (
          <li>
            <strong>{s.title}</strong>
            <span>{s.text}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <VizIndex heading="Visualizations by area" />

  <AreaList heading="The repository" areas={content.root.children} />
</BaseLayout>

<style>
  .study {
    margin-top: 56px;
  }
  h2 {
    font-size: 24px;
    font-weight: 700;
    line-height: 1.25;
    margin: 0 0 18px;
  }
  /* The three steps are a real sequence, so they are numbered; counter numerals in step blue. */
  ol {
    list-style: none;
    counter-reset: step;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    column-gap: 4px;
    row-gap: 4px;
    color: var(--text-2);
    font-size: 15.5px;
    line-height: 1.55;
  }
  li::before {
    content: counter(step);
    grid-row: 1;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 15px;
    line-height: 1.6;
    color: var(--accent);
  }
  li > * {
    grid-column: 2;
  }
  strong {
    color: var(--text);
    font-size: 17px;
  }
  @media (max-width: 720px) {
    ol {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }
  }
</style>
