---
import SectionTitle from '../components/atoms/SectionTitle.astro';
import Card from '../components/molecules/Card.astro';
import CardGrid from '../components/molecules/CardGrid.astro';
import StatTile from '../components/molecules/StatTile.astro';
import Hero from '../components/organisms/Hero.astro';
import TopicCards from '../components/organisms/TopicCards.astro';
import BaseLayout from '../components/templates/BaseLayout.astro';
import { getContent, joinBase, slugOfRel } from '../lib/repo';
import { VIZ_CATALOG, VIZ_GROUP_ORDER } from '../viz/catalog';

const content = getContent();
const base = import.meta.env.BASE_URL;
const topics = content.nodes.filter((n) => n.kind === 'topic');
const implementations = topics.reduce((sum, t) => sum + t.languages.length, 0);
const featured = VIZ_GROUP_ORDER.map((g) => VIZ_CATALOG.find((v) => v.group === g)).filter((v) => v !== undefined);
const DOT = String.fromCodePoint(0xb7);
const steps = [
  { title: `1 ${DOT} Read the intuition`, text: 'Each page starts from the README: the idea, a picture, and why it works.' },
  { title: `2 ${DOT} Step through it`, text: 'Run the visualization on your own input. Pause, rewind, and read the caption for every step.' },
  { title: `3 ${DOT} Compare the code`, text: 'Open the Python, C++ and Go tabs to see the same algorithm in three languages, with tests.' },
];
---

<BaseLayout title="DSA Playground" currentSlug="">
  <Hero />

  <div class="stats">
    <StatTile value={topics.length} label="topics" />
    <StatTile value={implementations} label="implementations" />
    <StatTile value={3} label="languages: Python, C++, Go" />
    <StatTile value={VIZ_CATALOG.length} label="interactive visualizations" />
  </div>

  <SectionTitle>How to study a topic</SectionTitle>
  <CardGrid min={220}>
    {steps.map((s) => <Card title={s.title} text={s.text} />)}
  </CardGrid>

  <SectionTitle>Start with a visualization</SectionTitle>
  <CardGrid>
    {
      featured.map((v) => (
        <Card href={`${joinBase(base, slugOfRel(content, v.topics[0]))}#visualize`} title={v.title} text={v.blurb} meta={[v.group]} />
      ))
    }
  </CardGrid>

  <SectionTitle>Explore the repository</SectionTitle>
  <TopicCards nodes={content.root.children} />
</BaseLayout>

<style>
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
    margin: 32px 0 8px;
  }
</style>
