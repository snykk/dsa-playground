---
import { getCollection, render } from 'astro:content';
import { MDX_COMPONENTS } from '../components/mdx';
import ArticlePage from '../components/templates/ArticlePage.astro';
import CategoryPage from '../components/templates/CategoryPage.astro';
import DocPage from '../components/templates/DocPage.astro';
import RootPage from '../components/templates/RootPage.astro';
import { renderMarkdown } from '../lib/markdown';
import { getContent } from '../lib/repo';

/**
 * One page per repository folder with a README, plus the root documents. A topic with a
 * hand-written article (src/content/articles) renders that, a category with a hand-written
 * overview (src/content/categories) renders that, a root document with a hand-written page
 * (src/content/pages) renders that; any other page renders its README or document.
 */
export async function getStaticPaths() {
  const content = getContent();
  const seen = new Set<string>();
  for (const article of await getCollection('articles')) {
    const { topic } = article.data;
    if (!content.byRel.has(topic)) throw new Error(`Article ${article.id}: unknown topic folder "${topic}"`);
    if (seen.has(topic)) throw new Error(`Two articles claim the topic "${topic}"`);
    seen.add(topic);
  }
  for (const overview of await getCollection('categories')) {
    const { category } = overview.data;
    if (content.byRel.get(category)?.kind !== 'category') {
      throw new Error(`Category overview ${overview.id}: "${category}" is not a category folder`);
    }
    if (seen.has(category)) throw new Error(`Two overviews claim the category "${category}"`);
    seen.add(category);
  }
  const pageSlugs = new Set<string>();
  for (const page of await getCollection('pages')) {
    const slug = page.data.page;
    if (!content.standalone.some((d) => d.slug === slug)) throw new Error(`Page ${page.id}: "${slug}" is not a root document`);
    if (pageSlugs.has(slug)) throw new Error(`Two pages claim the root document "${slug}"`);
    pageSlugs.add(slug);
  }
  return [
    ...content.nodes.map((n) => ({ params: { slug: n.slug }, props: { kind: 'node' as const, rel: n.rel } })),
    ...content.standalone.map((d) => ({ params: { slug: d.slug }, props: { kind: 'doc' as const, rel: d.rel } })),
  ];
}

interface Props {
  kind: 'node' | 'doc';
  rel: string;
}

const { kind, rel } = Astro.props;
const content = getContent();
const node = kind === 'node' ? content.byRel.get(rel) : undefined;
const doc = kind === 'doc' ? content.standalone.find((d) => d.rel === rel) : undefined;
if (!node && !doc) throw new Error(`Unknown page ${kind}:${rel}`);

const article = node?.kind === 'topic' ? (await getCollection('articles')).find((a) => a.data.topic === node.rel) : undefined;
const overview = node?.kind === 'category' ? (await getCollection('categories')).find((c) => c.data.category === node.rel) : undefined;
const page = doc ? (await getCollection('pages')).find((p) => p.data.page === doc.slug) : undefined;
const entry = article ?? overview ?? page;
const view = entry ? await render(entry) : undefined;
const Content = view?.Content;

const source = node?.readme ?? (doc ? { rel: doc.rel, source: doc.source } : undefined);
const rendered = !view && source ? await renderMarkdown(source.source, source.rel) : { html: '', headings: [] };
---

{
  node && article && view && Content ? (
    <ArticlePage node={node} article={article.data} headings={view.headings}>
      <Content components={MDX_COMPONENTS} />
    </ArticlePage>
  ) : node && overview && view && Content ? (
    <CategoryPage node={node} category={overview.data} headings={view.headings} hasViz={/<ArticleViz\b/.test(overview.body ?? '')}>
      <Content components={MDX_COMPONENTS} />
    </CategoryPage>
  ) : doc && page && view && Content ? (
    <RootPage doc={doc} page={page.data} headings={view.headings} hasViz={/<ArticleViz\b/.test(page.body ?? '')}>
      <Content components={MDX_COMPONENTS} />
    </RootPage>
  ) : (
    <DocPage node={node} doc={doc} rendered={rendered} />
  )
}
