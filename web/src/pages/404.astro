---
import BaseLayout from '../components/templates/BaseLayout.astro';
import { joinBase } from '../lib/repo';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Page not found">
  <article class="prose">
    <h1>Page not found</h1>
    <p>That page does not exist. Try the topic filter in the sidebar, or go back to the <a href={joinBase(base, '')}>home page</a>.</p>
  </article>
</BaseLayout>
